// Analysis parameters
params {
    input = null
    outdir = 'results'
    check_orientation = true
    min_base_fraction = 0.60
    min_family_fraction = 0.60
    min_families_per_call = 2
}

// Combine one executor profile with one container profile.
profiles {
    local {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
    }

    singularity {
        singularity.enabled = true
    }

    apptainer {
        apptainer.enabled = true
    }

    docker {
        docker.enabled = true
    }
}
